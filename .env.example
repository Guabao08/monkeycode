# Supabase Edge Function secrets / local functions serve --env-file .env.
# Never use VITE_ prefixes or put provider/service-role keys in Cloudflare Pages.
ONLINECOMPILER_API_KEY=
# The provider retains source/input/output in account execution history.
# Review https://onlinecompiler.io/privacy before enabling execution.
ONLINECOMPILER_RETENTION_ACCEPTED=false
MONKEYCODE_EXECUTION_ENABLED=false
# npm run invite:create -- seat-1 prints a raw invite and its SHA-256 digest.
# Configure only {"seat-1":"<64-hex digest>"}; privately deliver the raw token.
MONKEYCODE_INVITES_JSON={}
MONKEYCODE_ALLOWED_ORIGIN=http://127.0.0.1:5173
# Daily limits count admitted jobs; monthly limits count reserved runs (1/9).
MONKEYCODE_INVITE_DAILY_LIMIT=30
MONKEYCODE_GLOBAL_DAILY_LIMIT=300
MONKEYCODE_MONTHLY_RUN_LIMIT=90000

# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into the function.
# Do not override these in hosted secrets. The one-time legacy import command
# needs them in its private operator shell, plus MONKEYCODE_LEGACY_STOPPED=true.
# Cloudflare Pages needs only the server-side routing variable EXECUTION_API_URL:
# https://<project-ref>.supabase.co/functions/v1/execution
