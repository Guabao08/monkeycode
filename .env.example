# Server only. Never prefix these with VITE_ or commit real credentials.
ONLINECOMPILER_API_KEY=
# Explicit operator acknowledgement: the provider retains source/input/output
# in execution history while the provider account is active. Review its policy.
ONLINECOMPILER_RETENTION_ACCEPTED=false
# Admission kill switch; status reads remain available when disabled.
MONKEYCODE_EXECUTION_ENABLED=false
# npm run invite:create -- seat-1 produces a token and SHA-256 digest.
# Configure {"seat-1":"digest"}; share only the raw token with that invitee.
MONKEYCODE_INVITES_JSON={}
MONKEYCODE_ALLOWED_ORIGIN=http://127.0.0.1:5173
MONKEYCODE_HOST=127.0.0.1
MONKEYCODE_PORT=3001
MONKEYCODE_DB_PATH=.data/execution.sqlite
# Daily limits count user actions. Monthly limits count provider runs (1/9).
MONKEYCODE_INVITE_DAILY_LIMIT=30
MONKEYCODE_GLOBAL_DAILY_LIMIT=300
MONKEYCODE_MONTHLY_RUN_LIMIT=90000
