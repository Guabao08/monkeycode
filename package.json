{
  "name": "monkeycode",
  "private": true,
  "engines": {
    "node": ">=22.23.0"
  },
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts --serve-web",
    "test": "tsx --test src/*.test.ts server/*.test.ts server/execution/*.test.ts",
    "check:exercise": "tsx scripts/check-exercise.ts",
    "check:execution": "tsx scripts/check-execution.ts",
    "check:hosted": "node --env-file-if-exists=.env --import tsx scripts/smoke-hosted.ts",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx server/main.ts",
    "start:api": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "invite:create": "tsx scripts/create-invite.ts"
  },
  "dependencies": {
    "@fontsource/lexend-deca": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
